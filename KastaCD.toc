## Interface: 70300
## Title: Kasta|cffff7f00CD|r – Cooldown Tracker
## Notes: Tracks party/raid cooldowns on raid frames.
## Author: Kasta
## Version: 1.7.2
## SavedVariables: KastaCDDB
## OptionalDeps: SharedMedia, LibSharedMedia-3.0

# 0. Bundled Ace3 subset (AceGUI-3.0/AceConfig-3.0) that powers the
#    settings menu - must load before UI\KastaCD_Options.lua/KastaCD_UI.lua
KastaCD_libs.xml

# 1. Entry point: addon identity, version global, load message
Core\KastaCD.lua

# 2. Shared constants + class metadata (declares the global SPELL_DB
#    table that every Classes\*.lua file appends into - no dependencies)
Core\KastaCD_SpellDB.lua

# 3. Class spell definitions are now appended directly to KastaCD_SpellDB.lua above.

# 3b. KastaPlates' static per-dungeon NPC name/ID database (dropdown
#     pickers) - no dependencies, pure data like SpellDB above.
Core\KastaCD_KastaPlatesData.lua

# 4. SavedVariables / profile management + spec-detection/gating
#    (depends on SpellDB + Classes for SPELL_DB contents)
Core\KastaCD_DB.lua

# 5. Core tracking, icon building, layout (depends on DB + SpellDB)
Core\KastaCD_Tracking.lua

# 5b. Interrupt announcement (chat message on the player's own successful
#     interrupt) - depends on DB, must load before CombatLog uses it
Modules\KastaCD_Announce.lua

# 6. Combat log handler (depends on Tracking + Announce)
Core\KastaCD_CombatLog.lua

# 6b. Interrupt tracker (independent anchor, class-colored bars)
Modules\KastaCD_Interrupts.lua

# 6c. Crowd-control tracker (independent anchor, class-colored bars)
Modules\KastaCD_CC.lua

# 6d. Overshield display (hooks Blizzard's absorb-bar overlay so it shows
#     shield amounts past max HP) - depends on DB, must load before
#     Options.lua uses GetOvershieldDB()
Modules\KastaCD_Overshield.lua

# 6e. Keystone helper (Ready Check / Pull Timer buttons + auto-insert on
#     the Mythic+ Font of Power frame) - depends on DB, must load before
#     Options.lua uses GetKeystoneDB()
Modules\KastaCD_Keystone.lua

# 6ea. Key Announcer - responds to "!keys" (or /kcdkeys) by announcing
#      your owned Mythic Keystone's dungeon/level. Backported from the
#      standalone "MythicKeyAnnouncer" addon. Depends on
#      KastaCD_Keystone.lua's FindKeystoneBagSlot().
Modules\KastaCD_KeyAnnouncer.lua

# 6f. Ability sync - broadcasts your own confirmed spec/known-spell data
#     to other KastaCD users in the party so talent-gated abilities show
#     up instantly instead of waiting on Blizzard's inspect API (which
#     often never resolves on private servers) or a witnessed cast.
#     Depends on DB + SpellDB + CC + Tracking/Interrupts/CC's Rebuild*.
Modules\KastaCD_Sync.lua

# 6g. Mob Count - shows each Mythic+ trash mob's enemy-forces completion
#     percentage next to its nameplate. Depends on
#     libs\LibObjectiveProgress-1.0 (loaded via KastaCD_libs.xml).
Modules\KastaCD_MobCount.lua

# 6h. Affix call-outs - warns about Explosive orb spawns and Quaking
#     debuffs during a Mythic Keystone run. No dependencies beyond DB.
Modules\KastaCD_AffixCallouts.lua

# 6i. Personal Mythic+ leaderboard - records your own best completion
#     time per dungeon. No dependencies beyond DB.
Modules\KastaCD_Leaderboard.lua

# 6k. KastaPlates - recolors nameplates for user-flagged priority NPCs
#     per dungeon, plus an optional generic "unit is casting" highlight.
#     No dependencies beyond DB.
Modules\KastaCD_KastaPlates.lua

# 6l. Custom AceGUI widget (NPC 3D model preview) used by KastaPlates'
#     NPC picker - must load before KastaCD_Options.lua references its
#     type name.
UI\KastaCD_ModelWidget.lua

# 7. Settings UI options table (depends on DB + Tracking + Ace3 libs)
UI\KastaCD_Options.lua

# 7b. Settings UI bootstrap (depends on KastaCD_Options.lua)
UI\KastaCD_UI.lua

# 7c. Chat profile sharing ("Post to Chat" clickable import link) -
#     depends on DB + Options.lua (SerializeProfile/DeserializeProfile)
UI\KastaCD_ProfileShare.lua

# 8. Event frame + slash command + SpecPollTicker (depends on
#    everything above)
Core\KastaCD_Events.lua

# 9. Debug commands: /kcddebug  /kcdlevel  /kcdspec  (depends on
#    everything above)
Core\KastaCD_Debug.lua

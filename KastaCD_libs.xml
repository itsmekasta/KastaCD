<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Minimal Ace3 subset needed to render the settings menu with the
	     stock AceGUI-3.0/AceConfig-3.0 look (GladiusEx's actual style is
	     just this framework, not custom skinning). Load order matters:
	     LibStub/CallbackHandler-1.0 first, AceGUI-3.0 before the
	     SharedMedia widget extensions and before AceConfig-3.0. -->
	<Script file="libs\LibStub\LibStub.lua"/>
	<Include file="libs\CallbackHandler-1.0\CallbackHandler-1.0.xml"/>
	<Include file="libs\LibSharedMedia-3.0\lib.xml"/>
	<Include file="libs\AceGUI-3.0\AceGUI-3.0.xml"/>
	<Include file="libs\AceGUI-3.0-SharedMediaWidgets\widget.xml"/>
	<Include file="libs\AceConfig-3.0\AceConfig-3.0.xml"/>

	<!-- Mythic+ enemy-forces weight data (mob % contribution per dungeon),
	     used by KastaCD_MobCount.lua for the nameplate percentage display.
	     Standalone LibStub library, vendored from GottaGoFast - only
	     depends on LibStub (already loaded above). -->
	<Script file="libs\LibObjectiveProgress-1.0\LibObjectiveProgress-1.0.lua"/>
	<Script file="libs\LibObjectiveProgress-1.0\ProgressWeightData.lua"/>

	<!-- Recolorable clone of Blizzard's own action-button glow (vendored
	     from WeakAuras' Libs folder - only the "Action Button Glow"
	     function is used, not its animated "Proc Glow" style, which was
	     tried and reverted for looking like it kept restarting). Only
	     depends on LibStub (already loaded above). Used by ShowProcGlow/
	     HideProcGlow in KastaCD_Tracking.lua so every glow in the addon
	     can use Settings > Glow Color instead of the fixed stock gold. -->
	<Include file="libs\LibCustomGlow-1.0\LibCustomGlow-1.0.xml"/>
</Ui>
